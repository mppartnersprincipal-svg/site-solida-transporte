# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# Painel do Supabase → Project Settings → API Keys / Data API.
# NUNCA commitar o .env.local (já está no .gitignore).

# URL do projeto (Project Settings → Data API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (Project Settings → API Keys → anon public
# ou a nova "publishable key", sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA
