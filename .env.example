# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# Painel do Supabase → Project Settings → API Keys / Data API.
# NUNCA commitar o .env.local (já está no .gitignore).

# URL do projeto (Project Settings → Data API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (Project Settings → API Keys → anon public
# ou a nova "publishable key", sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA

# URL canonica do site (producao: dominio final apontado na Vercel)
NEXT_PUBLIC_SITE_URL=https://www.solidatransporte.com.br

# Analytics (plano secao 10) - deixar vazio desativa o carregamento
# GA4: Measurement ID (Google Analytics -> Administrador -> Fluxos de dados)
NEXT_PUBLIC_GA4_ID=
# Meta Pixel: ID do pixel (Gerenciador de Eventos da Meta)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Tag Manager (caminho principal - GA4 e Meta Pixel configurados no container)
# Nao preencher GA4/PIXEL diretos junto com o GTM (mediria em dobro)
NEXT_PUBLIC_GTM_ID=
